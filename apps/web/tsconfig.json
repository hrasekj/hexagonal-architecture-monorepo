{
  "extends": "@shared/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/amplify_outputs.json": ["../../amplify_outputs.json"],
      "@/*": ["./*"]
      // "@web/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"

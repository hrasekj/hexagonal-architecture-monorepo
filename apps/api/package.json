{
  "name": "@qseat/api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "ampx sandbox --outputs-out-dir ../../",
    "build": "echo 'No build script available'",
    "build:check": "tsc --noEmit",
    "deploy:backend": "ampx pipeline-deploy --outputs-out-dir ../../ --branch $AWS_BRANCH --app-id $AWS_APP_ID --debug",
    "lint": "biome lint",
    "lint:fix": "biome lint --write"
  },
  "exports": {
    "./amplify": "./amplify/backend.ts"
  },
  "devDependencies": {
    "@shared/biome-config": "workspace:*",
    "@types/aws-lambda": "^8.10.156",
    "@types/node": "^24.7.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.220.0",
    "zod": "^4.1.12"
  }
}
